{
  "openapi": "3.0.3",
  "info": {
    "title": "Library ISSTA Mutation Experiment",
    "version": "1.0.0",
    "description": "Normative contract for sut_buggy_issta.py with all mutations disabled. No per-user active-loan quota. A book may have at most one active loan; duplicate active user/book loans are rejected. Returning a loan permits unlimited future loan/return cycles for that pair. Deletion targets only the identified record. These rules clarify the experiment; the original repository contract is unchanged."
  },
  "paths": {
    "/users": {
      "post": {
        "summary": "Create a user",
        "operationId": "createUser",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UserCreate"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          },
          "400": {
            "description": "Invalid payload or unknown referenced user/book; for loans also an active loan already exists for this book"
          }
        }
      },
      "get": {
        "summary": "List/search users",
        "operationId": "listUsers",
        "parameters": [
          {
            "in": "query",
            "name": "q",
            "schema": {
              "type": "string"
            },
            "required": false,
            "description": "Free-text search query (e.g., name or id fragment)"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/User"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/users/{user_id}": {
      "delete": {
        "summary": "Delete a user",
        "operationId": "deleteUser",
        "parameters": [
          {
            "in": "path",
            "name": "user_id",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Deleted successfully"
          },
          "400": {
            "description": "Invalid identifier or deletion blocked by an active loan/hold"
          },
          "404": {
            "description": "Target not found"
          }
        }
      }
    },
    "/books": {
      "post": {
        "summary": "Create a book",
        "operationId": "createBook",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BookCreate"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Book"
                }
              }
            }
          },
          "400": {
            "description": "Invalid payload or unknown referenced user/book; for loans also an active loan already exists for this book"
          }
        }
      },
      "get": {
        "summary": "List/search books",
        "operationId": "listBooks",
        "parameters": [
          {
            "in": "query",
            "name": "q",
            "schema": {
              "type": "string"
            },
            "required": false,
            "description": "Free-text search query"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Book"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/books/{book_id}": {
      "get": {
        "summary": "Get book by id",
        "operationId": "getBook",
        "parameters": [
          {
            "in": "path",
            "name": "book_id",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Book"
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          }
        },
        "description": "For an existing book created by this API and not deleted, return 200 with that exact book. Reading does not change state. Return 404 only if no book with the parsed ID exists."
      },
      "delete": {
        "summary": "Delete a book",
        "operationId": "deleteBook",
        "parameters": [
          {
            "in": "path",
            "name": "book_id",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Deleted successfully"
          },
          "400": {
            "description": "Invalid identifier or deletion blocked by an active loan/hold"
          },
          "404": {
            "description": "Target not found"
          }
        }
      }
    },
    "/loans": {
      "post": {
        "summary": "Create a loan",
        "operationId": "createLoan",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoanCreate"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Loan"
                }
              }
            }
          },
          "400": {
            "description": "Invalid payload or unknown referenced user/book; for loans also an active loan already exists for this book"
          }
        },
        "description": "Create a loan for existing user and book IDs. No per-user quota: four or more distinct available books may be loaned to one user. Reject an already-loaned book. Returned loans do not count as active and do not limit subsequent borrowing, including the third loan of the same book by the same user."
      },
      "get": {
        "summary": "List/search loans",
        "operationId": "listLoans",
        "parameters": [
          {
            "in": "query",
            "name": "userId",
            "schema": {
              "type": "integer"
            },
            "required": false
          },
          {
            "in": "query",
            "name": "bookId",
            "schema": {
              "type": "integer"
            },
            "required": false
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Loan"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/loans/{user_id}/{book_id}": {
      "delete": {
        "summary": "Delete a loan by composite id",
        "operationId": "deleteLoan",
        "parameters": [
          {
            "in": "path",
            "name": "user_id",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "in": "path",
            "name": "book_id",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Deleted successfully"
          },
          "400": {
            "description": "Invalid identifier or deletion blocked by an active loan/hold"
          },
          "404": {
            "description": "Target not found"
          }
        },
        "description": "Return exactly the active loan identified by BOTH user_id and book_id. Other loans are unchanged."
      }
    },
    "/holds": {
      "post": {
        "summary": "Create a hold",
        "operationId": "createHold",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/HoldCreate"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Hold"
                }
              }
            }
          },
          "400": {
            "description": "Invalid payload or unknown referenced user/book; for loans also an active loan already exists for this book"
          }
        }
      },
      "get": {
        "summary": "List holds",
        "operationId": "listHolds",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Hold"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/holds/{hold_id}": {
      "delete": {
        "summary": "Delete a hold",
        "operationId": "deleteHold",
        "parameters": [
          {
            "in": "path",
            "name": "hold_id",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Deleted successfully"
          },
          "400": {
            "description": "Invalid identifier or deletion blocked by an active loan/hold"
          },
          "404": {
            "description": "Target not found"
          }
        },
        "description": "Delete exactly the hold identified by hold_id. All other holds, including those belonging to the same user, remain unchanged."
      }
    }
  },
  "components": {
    "schemas": {
      "UserCreate": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "User": {
        "allOf": [
          {
            "$ref": "#/components/schemas/UserCreate"
          }
        ],
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "integer"
          }
        }
      },
      "BookCreate": {
        "type": "object",
        "required": [
          "title"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "Book": {
        "allOf": [
          {
            "$ref": "#/components/schemas/BookCreate"
          }
        ],
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "integer"
          }
        }
      },
      "LoanCreate": {
        "type": "object",
        "required": [
          "userId",
          "bookId"
        ],
        "properties": {
          "userId": {
            "type": "integer"
          },
          "bookId": {
            "type": "integer"
          }
        }
      },
      "Loan": {
        "type": "object",
        "required": [
          "id",
          "userId",
          "bookId"
        ],
        "properties": {
          "id": {
            "type": "integer"
          },
          "userId": {
            "type": "integer"
          },
          "bookId": {
            "type": "integer"
          },
          "loanedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "HoldCreate": {
        "type": "object",
        "required": [
          "userId",
          "bookId"
        ],
        "properties": {
          "userId": {
            "type": "integer"
          },
          "bookId": {
            "type": "integer"
          }
        }
      },
      "Hold": {
        "allOf": [
          {
            "$ref": "#/components/schemas/HoldCreate"
          }
        ],
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "integer"
          }
        }
      }
    }
  }
}
