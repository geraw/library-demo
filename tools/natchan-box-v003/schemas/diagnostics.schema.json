{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "diagnostics",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "natchan-diagnostics/1"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1
          },
          "message": {
            "type": "string"
          },
          "exception_type": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "items"
  ],
  "additionalProperties": false
}
