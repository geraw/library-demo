          },
          "404": {
            "description": "Rejected request; business state is unchanged.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "description": "Delete only the identified resource; reject deletion of a book/user with active loans or holds."
      }
    }
  },
  "components": {
    "schemas": {
      "UserCreate": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "User": {
        "type": "object",
        "required": [
          "name",
          "id"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "id": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "BookCreate": {
        "type": "object",
        "required": [
          "title"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "Book": {
        "type": "object",
        "required": [
          "title",
          "id"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          },
          "id": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "LoanCreate": {
        "type": "object",
        "required": [
          "userId",
          "bookId"
        ],
        "properties": {
          "userId": {
            "oneOf": [
              {
                "type": "integer",
                "minimum": 1
              },
              {
                "type": "string",
                "pattern": "^ *0*[1-9][0-9]* *$"
              }
            ]
          },
          "bookId": {
            "oneOf": [
              {
                "type": "integer",
                "minimum": 1
              },
              {
                "type": "string",
                "pattern": "^ *0*[1-9][0-9]* *$"
              }
            ]
          }
        }
      },
      "Loan": {
        "type": "object",
        "required": [
          "id",
          "userId",
          "bookId"
        ],
        "properties": {
          "id": {
            "type": "integer"
          },
          "userId": {
            "type": "integer"
          },
          "bookId": {
            "type": "integer"
          },
          "loanedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "HoldCreate": {
        "type": "object",
        "required": [
          "userId",
          "bookId"
        ],
        "properties": {
          "userId": {
            "oneOf": [
              {
                "type": "integer",
                "minimum": 1
              },
              {
                "type": "string",
                "pattern": "^ *0*[1-9][0-9]* *$"
              }
            ]
          },
          "bookId": {
            "oneOf": [
              {
                "type": "integer",
                "minimum": 1
              },
              {
                "type": "string",
                "pattern": "^ *0*[1-9][0-9]* *$"
              }
            ]
          }
        }
      },
      "Hold": {
        "type": "object",
        "required": [
          "userId",
          "bookId",
          "id"
        ],
        "properties": {
          "userId": {
            "type": "integer"
          },
          "bookId": {
            "type": "integer"
          },
          "id": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string"
          }
        }
      }
    }
  },
  "servers": [
    {
      "url": "http://127.0.0.1:23443"
    }
  ]
}
